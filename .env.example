"""
Файл .env для локальных переменных окружения
НЕ коммитьте этот файл в git!
Используйте .env.example для шаблона

Примеры переменных:
"""
BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://127.0.0.1:8000
API_TITLE=Request Service API
API_REQUEST_TIMEOUT=5
MAX_ACTIVE_REQUESTS=2
CLEANUP_INTERVAL_SECONDS=3600
COMPLETED_REQUEST_RETENTION_DAYS=30
DEBUG=False
TIMEZONE=Europe/Moscow
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
SERVICE_TOKEN=replace_with_a_random_secret
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# True only when served over HTTPS (production) — keep False for local HTTP dev
COOKIE_SECURE=False